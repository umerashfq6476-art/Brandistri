# ─────────────────────────────────────────────────────────────────────────────
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────────────────────

# Project URL (Settings → API → Project URL). Exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key (Settings → API → Project API keys → anon public).
# Safe to expose; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# service_role key (Settings → API → Project API keys → service_role).
# SERVER-ONLY. Bypasses RLS. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─────────────────────────────────────────────────────────────────────────────
# Resend transactional email — https://resend.com
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=your_resend_api_key

# Optional: override the "from" address used by Resend.
# Defaults to "Brandistri <onboarding@resend.dev>" (Resend's sandbox sender)
# until you verify a custom domain in the Resend dashboard.
RESEND_FROM_EMAIL=Brandistri <hello@yourdomain.com>

# Where new contact inquiries are delivered
CONTACT_EMAIL=mashab@brandistri.com

# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used in email links and OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
